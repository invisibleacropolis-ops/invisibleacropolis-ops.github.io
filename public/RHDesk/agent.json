{
  "name": "RHDesk",
  "description": "Single source of truth desk for agentic trading on Robinhood. Pair, start a session, follow next_actions.",
  "protocol_version": 1,
  "protocol_updated": "2026-10-16",
  "roles": [
    "archivist",
    "novelist",
    "operator"
  ],
  "scopes": [
    "read",
    "operator",
    "operator+execute",
    "archivist",
    "novelist"
  ],
  "site_url": "https://invisibleacropolis-ops.github.io/RHDesk",
  "docs": {
    "onboarding_html": "https://invisibleacropolis-ops.github.io/RHDesk/agent/",
    "onboarding_markdown": "https://invisibleacropolis-ops.github.io/RHDesk/agent.md",
    "llms_txt": "https://invisibleacropolis-ops.github.io/RHDesk/llms.txt",
    "openapi": "https://invisibleacropolis-ops.github.io/RHDesk/openapi.json"
  },
  "api": {
    "base_url": "https://ypmjwhrvonuwcrpckwkk.supabase.co",
    "anon_key": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlwbWp3aHJ2b251d2NycGNrd2trIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE0MTAyMzAsImV4cCI6MjEwNjk4NjIzMH0.8H58CZRi_CzXwcEtdLd6TxVLvc--GSSZlfPluFcl_wo",
    "rest": "https://ypmjwhrvonuwcrpckwkk.supabase.co/rest/v1",
    "rpc": "https://ypmjwhrvonuwcrpckwkk.supabase.co/rest/v1/rpc/{function}",
    "headers": {
      "apikey": "<anon_key>",
      "Authorization": "Bearer <access_token>",
      "Content-Type": "application/json"
    },
    "envelope": "{ \"data\": ..., \"next_actions\": [ { \"type\", \"name\", \"why\", \"args\" } ] }"
  },
  "auth": {
    "method": "pairing",
    "pair_start": {
      "method": "POST",
      "url": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/agent-auth/pair/start",
      "body": {
        "agent_label": "string",
        "model": "string",
        "harness": "string",
        "requested_scope": "read | operator | operator+execute | archivist | novelist"
      }
    },
    "pair_complete": {
      "method": "POST",
      "url": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/agent-auth/pair/complete",
      "body": {
        "poll_secret": "string"
      },
      "poll_interval_seconds": 5
    },
    "key_exchange": {
      "method": "POST",
      "url": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/agent-auth/key/exchange",
      "body": {
        "key": "string (from env, e.g. RHDESK_AGENT_KEY)",
        "agent_label": "string"
      }
    },
    "refresh": {
      "method": "POST",
      "url": "https://ypmjwhrvonuwcrpckwkk.supabase.co/auth/v1/token?grant_type=refresh_token",
      "headers": {
        "apikey": "<anon_key>"
      },
      "body": {
        "refresh_token": "string"
      }
    }
  },
  "memory": {
    "about": "Semantic memory searched by meaning (gte-small embeddings): memory, journal, scout, proposal, task, archive, document. Indexed in the background every two minutes. Send your access token.",
    "headers": {
      "Authorization": "Bearer <access_token>",
      "Content-Type": "application/json"
    },
    "recall": {
      "method": "POST",
      "url": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/memory/recall",
      "body": {
        "query": "string",
        "k": "number (default 8)",
        "sources": "subset of [\"memory\",\"journal\",\"scout\",\"proposal\",\"task\",\"archive\",\"document\"] (optional)",
        "symbols": "[\"AAPL\"] (optional)"
      }
    },
    "index": {
      "method": "POST",
      "url": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/memory/index",
      "body": {}
    }
  },
  "first_call_after_auth": {
    "rpc": "session_start",
    "args": {
      "p_agent_label": "string",
      "p_model": "string",
      "p_harness": "string",
      "p_capabilities": {
        "robinhood_mcp": "boolean",
        "browser": "boolean",
        "shell": "boolean",
        "web_search": "boolean"
      }
    }
  },
  "operator": {
    "mission": "Research, develop and adapt strategies, and execute toward the owner mandate using current market observations and Desk history. An evidence-supported hold or research decision is valid.",
    "capabilities": {
      "rpc": "execution_capabilities",
      "also_in": "session_start.data.brief.capabilities",
      "rule": "Read current scope, mode and effective permissions. A capability declaration does not grant authorization."
    },
    "execution": {
      "required_scope": "operator+execute",
      "asset_classes": [
        "equity",
        "etf"
      ],
      "order_types": [
        "market",
        "limit",
        "stop_market",
        "stop_limit"
      ],
      "routes": {
        "approved_proposal": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/execute",
        "trade": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/execute/trade",
        "cancel": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/execute/cancel",
        "manage": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/execute/manage",
        "refresh": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/execute/refresh"
      },
      "rules": "Use Desk order routes only. Exits/protection do not consume entry allowances. Full freeze and held-share reservations still apply. Reconcile uncertain outcomes with the original identity; never resubmit under a new key.",
      "protection": "Asynchronous after observed fills; inspect brief.protection_lifecycle for actual broker-confirmed coverage."
    },
    "close_in_order": [
      "decision_record",
      "session_report_build",
      "robinhood-read: get_portfolio and get_equity_positions",
      "session_report_verify",
      "diary_submit",
      "session_end"
    ],
    "research": {
      "native_search": "The built-in runner exposes provider-native web_search when research is enabled; availability depends on the configured provider/model/account. External agents use their own harness tools.",
      "capture_url": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/clip",
      "additional_search_url": "https://ypmjwhrvonuwcrpckwkk.supabase.co/functions/v1/clip/search",
      "additional_search_requires": "Server-side LangSearch configuration and research permission; no search credential is supplied by the agent."
    }
  },
  "robinhood_mcp": {
    "url": "https://agent.robinhood.com/mcp/trading",
    "transport": "http",
    "auth": "OAuth (the account holder signs in)",
    "required": false,
    "usage": "The owner links Robinhood in Desk Settings. Use Desk refresh and read-only broker routes; separate MCP setup is optional for external read-only work. Never place orders directly through MCP. Report evidence must be captured through the Desk.",
    "setup": {
      "claude_code": "claude mcp add --transport http robinhood-trading https://agent.robinhood.com/mcp/trading"
    }
  }
}
